# EcoPoint Frontend — Environment Configuration
# Salin file ini ke .env lalu sesuaikan nilainya.
#
# PENTING untuk production (Vercel):
#   VITE_API_URL wajib diisi dengan URL backend Railway.
#   Tanpa ini, semua request API akan kena 404 karena Vercel
#   tidak mengetahui route /api/*.
#
# Cara set di Vercel:
#   Dashboard → Project → Settings → Environment Variables
#   Key   : VITE_API_URL
#   Value : https://<nama-service>.up.railway.app
#   Env   : Production (dan Preview jika perlu)
#   Lalu klik Redeploy.

# URL backend Railway — WAJIB diisi di production.
# Contoh: https://ecopoint-backend.up.railway.app
# Biarkan kosong HANYA saat development lokal (Vite proxy akan menanganinya).
VITE_API_URL=

# Target proxy untuk Vite dev server (development lokal saja, tidak dipakai Vercel).
VITE_API_TARGET=http://localhost:8080

# Port dev server Vite (development lokal saja).
VITE_PORT=5173

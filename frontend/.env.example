# EcoPoint Frontend — Environment Configuration
# Salin file ini ke .env lalu ubah nilainya sesuai kebutuhan.

# URL backend Golang yang dipakai Vite sebagai proxy (untuk mode dev).
VITE_API_TARGET=http://localhost:8080

# Opsional: jika diisi, frontend memanggil API langsung ke URL ini
# (biarkan kosong untuk memakai proxy dev Vite).
VITE_API_URL=

# Port server dev Vite.
VITE_PORT=5173